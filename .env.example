DATABASE_URL=postgresql://user:password@host:5432/oncamp
HIKERAPI_ACCESS_KEY=your_key_here
HIKER_BASE_URL=https://api.instagrapi.com
HIKER_FOLLOWING_ENDPOINT=/gql/user/following/chunk
HIKER_FOLLOWING_FORCE=true
HIKER_PAGE_SIZE=50
HIKER_MAX_PAGES=25
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
SEED_ACCOUNT=hunterusg
COLLEGE_KEY=hunter
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
RATELIMIT_DEFAULT=120 per minute
FLASK_APP=run.py
FLASK_DEBUG=1

# Use a long random value for deployed environments. Do not commit real secrets.
SECRET_KEY=replace-with-a-random-secret
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax

# Google sign-in: OAuth "Web application" client ID (same value as frontend/.env VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Days of events a signed-out visitor can see.
ANON_EVENT_DAYS=7
